VITE_AWS_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=your_user_pool_id
VITE_COGNITO_CLIENT_ID=your_client_id
VITE_HTTP_API_URL=https://your_api_id.execute-api.ap-south-1.amazonaws.com/

# ── Admin User Setup ──────────────────────────────────────────────
# Used by `npm run create:admin` to provision the default admin account
# in Cognito + DynamoDB (run once, server-side only — NOT exposed to browser)
ADMIN_EMAIL=admin@eventtrail.dev
ADMIN_PASSWORD=YourSecurePassword123!
ADMIN_NAME=Platform Admin

# ── Admin Quick Login (browser dev shortcut) ─────────────────────
# VITE_ prefix exposes these to the Vite frontend — use ONLY in local dev.
# Remove or leave blank in production deployments.
VITE_ADMIN_EMAIL=admin@eventtrail.dev
VITE_ADMIN_PASSWORD=YourSecurePassword123!
